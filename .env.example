# Instance registry: short key = base URL (comma separated)
GITHOST_INSTANCES=taf=https://git.taf.sh,codeberg=https://codeberg.org,gitea=https://gitea.com

# Optional per-instance tokens (key uppercased, non-alphanumeric to underscore)
GITHOST_TOKEN_TAF=
GITHOST_TOKEN_CODEBERG=
GITHOST_TOKEN_GITEA=

# Caller-supplied base_url support
GITHOST_ALLOW_CUSTOM_BASE=true
GITHOST_BLOCK_PRIVATE_IPS=true
GITHOST_CUSTOM_CONCURRENCY=2

# Deep history walk caps
GITHOST_HISTORY_MAX_PAGES=40
GITHOST_REQUEST_DEADLINE=3.5

# Cache / rate limit (same knobs as the sibling services)
API_CACHE_TTL_SECONDS=3600
INVALID_USER_CACHE_TTL_SECONDS=300
RATE_LIMIT_IP_REQUESTS=60
RATE_LIMIT_HANDLE_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional Redis / Upstash REST cache
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
